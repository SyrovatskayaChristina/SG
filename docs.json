{
  "$schema": "https://mintlify.com/docs.json",
  "name": "SolanaGun",
  "theme": "maple",
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#32B665",
    "light": "#47C78A",
    "dark": "#32B665"
  },
  "background": {
    "color": {
      "dark": "#000000",
      "light": "#FFFFFF"
    }
  },
  "fonts": {
    "heading": {
      "family": "Poppins",
      "weight": 600
    },
    "body": {
      "family": "Poppins",
      "weight": 400
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting started",
        "pages": [
          "introduction",
          {
            "group": "How to set up",
            "expanded": true,
            "pages": [
              "how-to-set-up/rpc",
              "how-to-set-up/websocket",
              "how-to-set-up/quic"
            ]
          }
        ]
      }
    ]
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": "system"
  },
  "search": {
    "prompt": "Search docs..."
  },
  "navbar": {
    "links": [
      {
        "label": "Allnodes",
        "href": "https://www.allnodes.com"
      }
    ]
  },
  "feedback": {
    "thumbsRating": true
  }
}
