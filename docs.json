{
  "$schema": "https://mintlify.com/docs.json",
  "name": "SolanaGun",
  "theme": "maple",
  "modeToggle": {
    "default": "dark",
    "isHidden": true
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#1E78FF",
    "light": "#4A9AFF",
    "dark": "#1E78FF"
  },
  "background": {
    "decoration": "grid",
    "color": {
      "dark": "#0D0D0D",
      "light": "#FFFFFF"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting started",
        "pages": [
          "introduction",
          {
            "group": "How to set up",
            "pages": [
              "how-to-set-up/rpc",
              "how-to-set-up/websocket",
              "how-to-set-up/quic"
            ]
          }
        ]
      }
    ]
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": "system"
  },
  "search": {
    "prompt": "Search docs..."
  },
  "navbar": {
    "links": [
      {
        "label": "Allnodes",
        "href": "https://www.allnodes.com"
      }
    ]
  },
  "feedback": {
    "thumbsRating": true
  }
}
