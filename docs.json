{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Solana Gun",
  "theme": "maple",
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "favicon": "/favicon.png",
  "icons": {
    "library": "lucide"
  },
  "colors": {
    "primary": "#EF6E47",
    "light": "#F08145",
    "dark": "#EF6E47"
  },
  "background": {
    "color": {
      "dark": "#000000",
      "light": "#FFFFFF"
    }
  },
  "fonts": {
    "heading": {
      "family": "Poppins",
      "weight": 600
    },
    "body": {
      "family": "Poppins",
      "weight": 400
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting started",
        "pages": [
          "introduction"
        ]
      },
      {
        "group": "How to set up",
        "pages": [
          "how-to-set-up/quic(recommended)",
          "how-to-set-up/rpc",
          "how-to-set-up/websocket"
        ]
      }
    ]
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": "system"
  },
  "search": {
    "prompt": "Search docs..."
  },
  "navbar": {
    "links": [
      {
        "label": "Allnodes",
        "href": "https://www.allnodes.com"
      }
    ]
  },
  "feedback": {
    "thumbsRating": true
  },
  "description": "SolanaGun\nTransactions landing service for Solana by Allnodes"
}
